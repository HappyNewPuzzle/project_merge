<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML 문서는 코드의 공개 API 주석을 빌드 결과에도 남겨 추후 API 문서화에 사용합니다. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 공개 API에 XML 주석이 없는 경우에도 초기 개발 단계의 빌드를 막지 않습니다. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 마이그레이션 생성 도구가 서버의 EF Core 모델을 분석할 때만 사용합니다. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- 모든 EF Core 어셈블리를 같은 보안 패치 버전으로 통일합니다. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.29" />
    <!-- EF Core 모델을 MySQL 8용 SQL과 데이터 형식으로 변환하는 공급자입니다. -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
  </ItemGroup>

</Project>
